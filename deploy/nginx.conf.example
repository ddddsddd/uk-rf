# Если на сервере уже есть nginx: положите это в /etc/nginx/sites-available/uk-rps,
# сделайте ссылку в sites-enabled, затем: sudo nginx -t && sudo systemctl reload nginx
# HTTPS: sudo certbot --nginx -d game.example.ru
# Игру при этом ставьте так: sudo bash deploy/install.sh game.example.ru
# (она будет слушать 127.0.0.1:3000, а Caddy установщик ставить не станет, увидев занятый порт 80).

server {
    listen 80;
    server_name game.example.ru;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
        proxy_buffering off;
    }
}
